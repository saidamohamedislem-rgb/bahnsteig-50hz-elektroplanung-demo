(vl-load-com)
(setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
(setq fp (open "C:/Users/mouha/Documents/Codex/2026-11-04/remote-desktop-commander-https-files-openai-4/work/cad_bounds.txt" "w"))
(vlax-for ob (vla-get-ModelSpace doc)
 (setq lo nil hi nil)
 (if (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-GetBoundingBox (list ob 'lo 'hi))))
  (write-line (strcat (vla-get-ObjectName ob) "|" (vla-get-Layer ob) "|" (if (vlax-property-available-p ob 'Name) (vla-get-Name ob) "") "|" (vl-princ-to-string (vlax-safearray->list lo)) "|" (vl-princ-to-string (vlax-safearray->list hi))) fp)))
(close fp)
(princ "\nCAD bounds audit saved.\n")
(princ)
